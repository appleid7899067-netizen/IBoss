{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "operator",
  "snapshot": false,
  "autoupdate": false,
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 8000
  },
  "watcher": {
    "ignore": [
      ".git/**",
      "node_modules/**",
      "dist/**",
      "build/**",
      ".next/**",
      "__pycache__/**",
      "**/__pycache__/**",
      ".venv/**",
      "venv/**",
      ".pytest_cache/**",
      "coverage/**",
      "tmp/**",
      "temp/**",
      "logs/**"
    ]
  },
  "permission": {
    "skill": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "task": "ask"
  },
  "tool_output": {
    "max_lines": 1200,
    "max_bytes": 32768
  }
}
